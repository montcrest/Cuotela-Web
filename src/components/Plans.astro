---
const plans = [
  {
    name: 'Básico',
    price: 'Gratis',
    period: 'Siempre',
    desc: 'Para comenzar y conocer la plataforma.',
    color: 'border-white/10',
    features: [
      'Registro y perfil completo',
      '1 obligación alimentaria activa',
      'Historial de pagos básico',
      '2 consultas legales/mes (IA)',
      'Alertas de vencimiento',
      'Soporte por email',
    ],
    cta: 'Comenzar gratis',
    ctaHref: 'https://app.cuotela.co/registro',
    popular: false,
  },
  {
    name: 'Obligado',
    price: '$29.900',
    period: '/mes',
    desc: 'Para el padre o madre que paga la cuota.',
    color: 'border-emerald-600/60',
    features: [
      'Todo lo del plan Básico',
      'Obligaciones ilimitadas',
      'Pago directo certificado',
      'Ahorro voluntario activado',
      'Certificados con valor probatorio',
      'Alerta REDAM incluida',
      '1 consulta con abogado/mes',
      'Soporte prioritario',
    ],
    cta: 'Empezar ahora',
    ctaHref: 'https://app.cuotela.co/registro?plan=obligado',
    popular: true,
  },
  {
    name: 'Custodio',
    price: '$19.900',
    period: '/mes',
    desc: 'Para quien tiene la custodia del menor.',
    color: 'border-white/10',
    features: [
      'Seguimiento en tiempo real',
      'Alertas de pago recibido/mora',
      'Descarga de comprobantes',
      'Reporte para acciones legales',
      '1 consulta con abogado/mes',
      'Historial para procesos judiciales',
    ],
    cta: 'Empezar ahora',
    ctaHref: 'https://app.cuotela.co/registro?plan=custodio',
    popular: false,
  },
  {
    name: 'Empresarial',
    price: 'A medida',
    period: '',
    desc: 'Para firmas de abogados y empleadores.',
    color: 'border-white/10',
    features: [
      'Gestión de múltiples clientes',
      'API de integración',
      'Panel de control avanzado',
      'Reportes masivos',
      'SLA garantizado',
      'Onboarding dedicado',
      'Capacitación del equipo',
    ],
    cta: 'Contactar ventas',
    ctaHref: '/contacto',
    popular: false,
  },
];
---

<section id="planes" class="py-24 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center mb-14" data-reveal>
      <div class="section-badge">Precios transparentes</div>
      <h2 class="heading-lg mb-4">Planes para cada<br/><span class="gradient-text">situación familiar</span></h2>
      <p class="text-slate-400 max-w-xl mx-auto">
        Sin contratos. Sin sorpresas. Cancela cuando quieras. Todos los planes incluyen acceso al módulo legal básico.
      </p>
    </div>

    <!-- Plans grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 items-start">
      {plans.map((plan, i) => (
        <div
          class={`card p-6 flex flex-col gap-5 relative ${plan.popular ? 'plan-popular' : ''}`}
          data-reveal
          style={`transition-delay: ${i * 80}ms`}
        >
          {plan.popular && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2">
              <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-600 text-white">
                ⭐ Más popular
              </span>
            </div>
          )}

          <div>
            <h3 class="font-display font-bold text-white text-lg">{plan.name}</h3>
            <p class="text-slate-500 text-xs mt-0.5">{plan.desc}</p>
          </div>

          <div class="flex items-baseline gap-1">
            <span class={`font-display font-bold text-3xl ${plan.popular ? 'text-emerald-400' : 'text-white'}`}>
              {plan.price}
            </span>
            {plan.period && <span class="text-slate-500 text-sm">{plan.period}</span>}
          </div>

          <ul class="space-y-2.5 flex-1">
            {plan.features.map(f => (
              <li class="flex items-start gap-2 text-sm text-slate-300">
                <svg class="w-4 h-4 text-emerald-500 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/>
                </svg>
                {f}
              </li>
            ))}
          </ul>

          <a
            href={plan.ctaHref}
            class={plan.popular ? 'btn-primary justify-center' : 'btn-outline justify-center'}
          >
            {plan.cta}
          </a>
        </div>
      ))}
    </div>

    <!-- Guarantee -->
    <div class="text-center mt-10 text-slate-500 text-sm" data-reveal>
      <span class="text-emerald-400">✓</span> 14 días de prueba gratuita en planes de pago &nbsp;·&nbsp;
      <span class="text-emerald-400">✓</span> Sin tarjeta de crédito requerida &nbsp;·&nbsp;
      <span class="text-emerald-400">✓</span> Cancela en un clic
    </div>

  </div>
</section>
