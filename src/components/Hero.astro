---
---

<section class="relative min-h-screen flex items-center overflow-hidden pt-16" id="inicio">

  <!-- Background mesh -->
  <div class="absolute inset-0 hero-mesh"></div>
  <!-- Radial glow -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[700px] h-[500px] bg-emerald-600/10 rounded-full blur-[120px] pointer-events-none"></div>
  <!-- Grid overlay -->
  <div class="absolute inset-0 opacity-[0.04]"
    style="background-image: linear-gradient(rgba(255,255,255,0.15) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.15) 1px, transparent 1px); background-size: 60px 60px;"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
    <div class="max-w-4xl mx-auto text-center space-y-8">

      <!-- Badge -->
      <div class="flex justify-center">
        <div class="section-badge animate-fade-in" data-reveal>
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse-slow"></span>
          LegalTech + FinTech Colombia 🇨🇴
        </div>
      </div>

      <!-- Headline -->
      <h1 class="heading-xl text-balance animate-slide-up" data-reveal>
        La cuota alimentaria
        <br/>
        <span class="gradient-text">llegó directa</span>
        <br/>
        a donde debe ir
      </h1>

      <!-- Subheadline -->
      <p class="text-slate-400 text-lg md:text-xl leading-relaxed max-w-2xl mx-auto animate-slide-up animate-delay-100" data-reveal>
        Cuotela es la plataforma que permite pagar, ahorrar y cumplir las obligaciones alimentarias
        <strong class="text-white font-semibold"> directamente a los gastos del menor</strong> —
        educación, salud, ropa y recreación — sin que el dinero transite por ninguno de los padres.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2 animate-slide-up animate-delay-200" data-reveal>
        <a href="https://app.cuotela.co/registro" class="btn-primary text-base px-7 py-4">
          Comienza hoy — Es gratis
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
          </svg>
        </a>
        <a href="#como-funciona" class="btn-outline text-base px-7 py-4">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 0 1 0 1.972l-11.54 6.347a1.125 1.125 0 0 1-1.667-.986V5.653Z"/>
          </svg>
          Ver cómo funciona
        </a>
      </div>

      <!-- Trust bar -->
      <div class="flex flex-wrap items-center justify-center gap-6 pt-6 text-xs text-slate-500 animate-fade-in animate-delay-400" data-reveal>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"/>
          </svg>
          SSL & cifrado bancario
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21"/>
          </svg>
          Cuotela S.A.S. — Bogotá
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
          </svg>
          Historial de pagos certificado
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Z"/>
          </svg>
          Pagos Wompi / PSE / Nequi
        </div>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-8 animate-fade-in animate-delay-500" data-reveal>
        {[
          { num: '+390K', label: 'Procesos alimentarios/año en CO' },
          { num: '55.7%', label: 'Nacimientos fuera del matrimonio' },
          { num: '15K+', label: 'Procesos judiciales activos' },
          { num: '100%', label: 'Directo al gasto del menor' },
        ].map(stat => (
          <div class="stat-chip text-center">
            <span class="font-display font-bold text-xl text-emerald-400">{stat.num}</span>
            <span class="text-xs text-slate-500 mt-1 leading-tight">{stat.label}</span>
          </div>
        ))}
      </div>

    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-float opacity-50">
    <svg class="w-6 h-6 text-slate-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
    </svg>
  </div>
</section>
