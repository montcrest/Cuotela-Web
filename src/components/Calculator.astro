---
---

<section id="calculadora" class="py-24 relative">
  <!-- Glow bg -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
    <div class="w-[600px] h-[400px] bg-emerald-600/8 rounded-full blur-[100px]"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12" data-reveal>
      <div class="section-badge">Calculadora gratuita</div>
      <h2 class="heading-lg mb-4">¿Cuánto debería ser<br/><span class="gradient-text">la cuota alimentaria?</span></h2>
      <p class="text-slate-400 max-w-xl mx-auto">
        Calcula un estimado orientativo basado en los parámetros del Código Civil colombiano y la jurisprudencia de la Corte Suprema.
      </p>
    </div>

    <div class="max-w-3xl mx-auto" data-reveal>
      <div class="card border-gradient p-8 lg:p-10" x-data="calculator()">

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">

          <!-- SMLV -->
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-2">
              Salario del obligado (en SMLV)
            </label>
            <div class="relative">
              <select
                x-model="smlvObligado"
                class="input pr-10 appearance-none"
              >
                <option value="1">1 SMLV ($1.423.500)</option>
                <option value="2">2 SMLV ($2.847.000)</option>
                <option value="3" selected>3 SMLV ($4.270.500)</option>
                <option value="4">4 SMLV ($5.694.000)</option>
                <option value="5">5 SMLV ($7.117.500)</option>
                <option value="7">7 SMLV ($9.964.500)</option>
                <option value="10">10+ SMLV ($14.235.000+)</option>
              </select>
              <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
              </svg>
            </div>
          </div>

          <!-- Número de hijos -->
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-2">
              Número de menores a cargo
            </label>
            <div class="relative">
              <select x-model="numHijos" class="input pr-10 appearance-none">
                <option value="1" selected>1 hijo/a</option>
                <option value="2">2 hijos/as</option>
                <option value="3">3 hijos/as</option>
                <option value="4">4 o más</option>
              </select>
              <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
              </svg>
            </div>
          </div>

          <!-- Custodia compartida -->
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-2">
              Tipo de custodia
            </label>
            <div class="relative">
              <select x-model="custodia" class="input pr-10 appearance-none">
                <option value="exclusiva" selected>Custodia exclusiva (otro padre)</option>
                <option value="compartida">Custodia compartida (ambos padres)</option>
              </select>
              <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
              </svg>
            </div>
          </div>

          <!-- Edad del menor -->
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-2">
              Edad del menor (mayor)
            </label>
            <div class="relative">
              <select x-model="edadMenor" class="input pr-10 appearance-none">
                <option value="bebe">0-2 años (bebé)</option>
                <option value="infancia" selected>3-6 años (infancia)</option>
                <option value="escolar">7-12 años (escolar)</option>
                <option value="adolescente">13-17 años (adolescente)</option>
              </select>
              <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
              </svg>
            </div>
          </div>

        </div>

        <!-- Result -->
        <div class="mt-8 p-6 rounded-2xl bg-emerald-600/10 border border-emerald-600/30">
          <p class="text-slate-400 text-sm mb-1">Estimado mensual orientativo:</p>
          <div class="flex items-baseline gap-3">
            <span class="font-display font-bold text-4xl text-emerald-400" x-text="formatCOP(resultado())"></span>
            <span class="text-slate-500 text-sm">COP / mes</span>
          </div>
          <p class="text-xs text-slate-600 mt-3">
            ⚠️ Este cálculo es orientativo. La cuota definitiva la fija un juez o acuerdo conciliado.
            <a href="#asesoria" class="text-emerald-500 underline hover:text-emerald-400">Consulta con un abogado →</a>
          </p>
          <!-- Breakdown -->
          <div class="mt-4 grid grid-cols-3 gap-2">
            {[
              ['🎓 Educación', '35%'],
              ['🏥 Salud', '20%'],
              ['🍎 Alimentación', '25%'],
            ].map(([label, pct]) => (
              <div class="text-center p-2 rounded-lg bg-white/5">
                <div class="text-xs text-slate-400">{label}</div>
                <div class="font-semibold text-white text-sm">{pct}</div>
              </div>
            ))}
          </div>
        </div>

        <!-- CTA -->
        <div class="mt-6 flex flex-col sm:flex-row gap-3">
          <a href="https://app.cuotela.co/registro" class="btn-primary flex-1 justify-center">
            Comenzar a pagar con Cuotela
          </a>
          <a href="#asesoria" class="btn-outline flex-1 justify-center">
            Asesoría legal gratuita
          </a>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  const SMLV_2024 = 1423500;

  function calculator() {
    return {
      smlvObligado: 3,
      numHijos: 1,
      custodia: 'exclusiva',
      edadMenor: 'infancia',

      resultado() {
        const salario = this.smlvObligado * SMLV_2024;

        // Base: entre 25% y 40% del salario según jurisprudencia colombiana
        let pct = 0.30;

        // Ajuste por número de hijos
        const ajusteHijos = { 1: 1.0, 2: 1.3, 3: 1.5, 4: 1.65 };
        const factorHijos = ajusteHijos[Math.min(this.numHijos, 4)] || 1.65;

        // Ajuste por tipo de custodia
        const factorCustodia = this.custodia === 'compartida' ? 0.6 : 1.0;

        // Ajuste por edad
        const ajusteEdad = { bebe: 0.9, infancia: 1.0, escolar: 1.15, adolescente: 1.25 };
        const factorEdad = ajusteEdad[this.edadMenor] || 1.0;

        const cuota = salario * pct * factorHijos * factorCustodia * factorEdad;
        return Math.round(cuota / 1000) * 1000; // Redondear a miles
      },

      formatCOP(val) {
        return new Intl.NumberFormat('es-CO', {
          style: 'currency',
          currency: 'COP',
          minimumFractionDigits: 0,
          maximumFractionDigits: 0,
        }).format(val);
      }
    };
  }

  // Register for Alpine
  document.addEventListener('alpine:init', () => {
    Alpine.data('calculator', calculator);
  });
</script>
