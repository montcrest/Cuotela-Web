---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<BaseLayout
  title="Contacto — Cuotela"
  description="Escríbenos o agenda tu consulta legal gratuita con el equipo de Cuotela."
>
  <Nav />
  <main class="pt-24">

    <section class="py-20">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-14">
          <div class="section-badge justify-center">Estamos aquí</div>
          <h1 class="heading-xl mb-4">Hablemos</h1>
          <p class="text-slate-400 max-w-xl mx-auto">
            Primera consulta legal de 30 minutos sin costo. También resolvemos dudas sobre la plataforma y alianzas.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">

          <!-- Contact info -->
          <div class="space-y-6">
            <h2 class="font-display font-bold text-white text-xl">Canales de contacto</h2>

            {[
              {
                icon: '📧',
                title: 'Email general',
                value: 'hola@cuotela.co',
                href: 'mailto:hola@cuotela.co',
              },
              {
                icon: '⚖️',
                title: 'Asesoría jurídica',
                value: 'legal@cuotela.co',
                href: 'mailto:legal@cuotela.co',
              },
              {
                icon: '💼',
                title: 'Alianzas y ventas',
                value: 'alianzas@cuotela.co',
                href: 'mailto:alianzas@cuotela.co',
              },
              {
                icon: '📱',
                title: 'WhatsApp',
                value: '+57 300 000 0000',
                href: 'https://wa.me/573000000000',
              },
              {
                icon: '📍',
                title: 'Sede',
                value: 'Bogotá D.C., Colombia',
                href: null,
              },
            ].map(item => (
              <div class="flex items-center gap-4 card p-4">
                <div class="icon-box text-xl">{item.icon}</div>
                <div>
                  <p class="text-slate-500 text-xs">{item.title}</p>
                  {item.href
                    ? <a href={item.href} class="text-white font-medium hover:text-emerald-400 transition-colors">{item.value}</a>
                    : <p class="text-white font-medium">{item.value}</p>
                  }
                </div>
              </div>
            ))}
          </div>

          <!-- Contact form -->
          <div class="card p-8">
            <h2 class="font-display font-bold text-white text-xl mb-6">Envíanos un mensaje</h2>
            <form
              name="contacto"
              method="POST"
              data-netlify="true"
              data-netlify-honeypot="bot-field"
              class="space-y-4"
            >
              <input type="hidden" name="form-name" value="contacto" />
              <input type="hidden" name="bot-field" />

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium text-slate-300 mb-1.5">Nombre</label>
                  <input type="text" name="nombre" required placeholder="Tu nombre" class="input" />
                </div>
                <div>
                  <label class="block text-sm font-medium text-slate-300 mb-1.5">Teléfono</label>
                  <input type="tel" name="telefono" placeholder="+57 300..." class="input" />
                </div>
              </div>

              <div>
                <label class="block text-sm font-medium text-slate-300 mb-1.5">Email</label>
                <input type="email" name="email" required placeholder="tu@email.com" class="input" />
              </div>

              <div>
                <label class="block text-sm font-medium text-slate-300 mb-1.5">Motivo de contacto</label>
                <select name="motivo" class="input">
                  <option value="">Selecciona...</option>
                  <option>Consulta legal gratuita</option>
                  <option>Duda sobre la plataforma</option>
                  <option>Alianza o ventas</option>
                  <option>Prensa / medios</option>
                  <option>Otro</option>
                </select>
              </div>

              <div>
                <label class="block text-sm font-medium text-slate-300 mb-1.5">Mensaje</label>
                <textarea
                  name="mensaje"
                  rows="4"
                  required
                  placeholder="Cuéntanos tu situación o pregunta..."
                  class="input resize-none"
                ></textarea>
              </div>

              <button type="submit" class="btn-primary w-full justify-center py-3.5">
                Enviar mensaje
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5"/>
                </svg>
              </button>

              <p class="text-xs text-slate-600 text-center">
                Al enviar aceptas nuestra <a href="/privacidad" class="text-emerald-500 hover:underline">política de privacidad</a>.
              </p>
            </form>
          </div>

        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
